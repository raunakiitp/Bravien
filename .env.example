# ── App ───────────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://bravien:bravien@localhost:5432/bravien?schema=public"
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# ── OAuth (optional — a provider registers only when both ID and SECRET are set)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ── Bravien inference runtime ─────────────────────────────────────────────────
# Bravien answers from its own weights, served locally by
# `python scripts/serve.py`. There is deliberately no model-service API key
# here: no hosted LLM sits in this path, and none may be added.
BRAVIEN_RUNTIME_URL="http://127.0.0.1:8000"
BRAVIEN_RUNTIME_TIMEOUT_MS="180000"

# Which checkpoint the runtime loads. A checkpoint directory, or a run directory
# whose latest checkpoint should be used. Defaults to ./checkpoints/bravien.
BRAVIEN_CHECKPOINT="./checkpoints/bravien"

# Pin a model the runtime reports. Empty = whatever is loaded.
BRAVIEN_DEFAULT_MODEL=""

# Let the model name new conversations. Off by default: it costs a second
# generation and small checkpoints produce nonsense titles.
BRAVIEN_MODEL_TITLES="0"

# ── Tools / search ────────────────────────────────────────────────────────────
SEARCH_API_KEY=""
SEARCH_API_URL=""

# ── Storage ───────────────────────────────────────────────────────────────────
UPLOAD_DIR="./uploads"
MAX_UPLOAD_BYTES="20971520"

# ── Feature flags ─────────────────────────────────────────────────────────────
# Only flags backed by working code are listed. Vision, voice, image generation
# and code execution are not implemented, so they have no switch to flip.
FEATURE_MEMORY="true"
FEATURE_FILE_UPLOADS="true"
FEATURE_WEB_SEARCH="false"

# ── Observability (optional) ──────────────────────────────────────────────────
SENTRY_DSN=""
POSTHOG_KEY=""
POSTHOG_HOST=""
