# App
DATABASE_URL="postgresql://bravien:bravien@localhost:5432/bravien?schema=public"
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# OAuth (optional — providers register only when both ID and SECRET are set)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# LLM providers
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
ANTHROPIC_API_KEY=""

# Default / fallback model ids
BRAVIEN_MODEL_DEFAULT="gpt-4o-mini"
BRAVIEN_MODEL_FAST="gpt-4o-mini"
BRAVIEN_MODEL_SMART="gpt-4o"
BRAVIEN_MODEL_REASONING="o3-mini"
BRAVIEN_MODEL_ANTHROPIC="claude-sonnet-4-20250514"

# Tools / search
SEARCH_API_KEY=""
SEARCH_API_URL=""

# Storage
UPLOAD_DIR="./uploads"
MAX_UPLOAD_BYTES="20971520"

# Feature flags (comma-separated keys enabled by default, or use Feature FeatureFlag)
FEATURE_MEMORY="true"
FEATURE_TOOLS="true"
FEATURE_SHARING="true"
FEATURE_API_KEYS="false"

# Observability (optional)
SENTRY_DSN=""
POSTHOG_KEY=""
POSTHOG_HOST=""
