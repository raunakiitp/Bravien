generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum MessageRole {
  system
  user
  assistant
  tool
}

enum MessageFeedback {
  LIKE
  DISLIKE
}

enum AttachmentStatus {
  PENDING
  READY
  FAILED
}

enum MemoryType {
  EXPLICIT
  PREFERENCE
  PROJECT
  CONVERSATION
  PROFILE
  INSTRUCTION
  FACT
  WORKFLOW
}

enum ToolExecutionStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
}

enum Plan {
  FREE
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  TRIALING
  INCOMPLETE
}

model User {
  id                   String    @id @default(cuid())
  name                 String?
  email                String    @unique
  emailVerified        DateTime?
  image                String?
  passwordHash         String?
  role                 Role      @default(USER)
  personalInstructions String?
  responseStyle        String?
  preferredModel       String?
  language             String?   @default("en")
  theme                String?   @default("system")
  memoryEnabled        Boolean   @default(true)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  projects      Project[]
  conversations Conversation[]
  memories      Memory[]
  attachments   Attachment[]
  usageRecords  UsageRecord[]
  feedbacks     Feedback[]
  apiKeys       ApiKey[]
  subscription  Subscription?
  tasks         Task[]
  activityLogs  ActivityLog[]
}

model Project {
  id           String   @id @default(cuid())
  userId       String
  name         String
  description  String?
  instructions String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  attachments   Attachment[]
  memories      Memory[]
  chunks        DocumentChunk[]
  tasks         Task[]
  activityLogs  ActivityLog[]

  @@index([userId, updatedAt])
  @@index([userId, name])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Conversation {
  id        String    @id @default(cuid())
  userId    String
  projectId String?
  title     String
  model     String
  pinned    Boolean   @default(false)
  archived  Boolean   @default(false)
  shareId   String?   @unique
  sharedAt  DateTime?
  summary   String?
  metadata  Json?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  project         Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  messages        Message[]
  attachments     Attachment[]
  toolExecutions  ToolExecution[]
  usageRecords    UsageRecord[]
  sourceMemories  Memory[]

  @@index([userId, updatedAt])
  @@index([userId, title])
  @@index([projectId, updatedAt])
}

model Message {
  id             String           @id @default(cuid())
  conversationId String
  role           MessageRole
  content        String           @db.Text
  parentId       String?
  attachments    Json?
  toolCalls      Json?
  citations      Json?
  feedback       MessageFeedback?
  metadata       Json?
  createdAt      DateTime         @default(now())

  conversation   Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  parent         Message?        @relation("MessageBranch", fields: [parentId], references: [id], onDelete: SetNull)
  children       Message[]       @relation("MessageBranch")
  messageAttachments Attachment[]
  toolExecutions ToolExecution[]
  feedbacks      Feedback[]

  // Content search via ILIKE in app queries; add pg_trgm GIN index in a raw migration if needed
  @@index([conversationId, createdAt])
}

model Attachment {
  id             String           @id @default(cuid())
  userId         String
  projectId      String?
  conversationId String?
  messageId      String?
  filename       String
  mimeType       String
  size           Int
  storagePath    String
  extractedText  String?          @db.Text
  status         AttachmentStatus @default(PENDING)
  metadata       Json?
  createdAt      DateTime         @default(now())

  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  project        Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  conversation   Conversation?    @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  message        Message?         @relation(fields: [messageId], references: [id], onDelete: SetNull)
  documentChunks DocumentChunk[]

  @@index([userId])
  @@index([projectId])
}

model DocumentChunk {
  id           String   @id @default(cuid())
  projectId    String?
  attachmentId String
  chunkIndex   Int
  content      String   @db.Text
  tokenCount   Int?
  metadata     Json?
  createdAt    DateTime @default(now())

  project    Project?   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  attachment Attachment @relation(fields: [attachmentId], references: [id], onDelete: Cascade)

  @@index([projectId, chunkIndex])
  @@index([attachmentId, chunkIndex])
}

model Memory {
  id                   String     @id @default(cuid())
  userId               String
  projectId            String?
  type                 MemoryType
  content              String     @db.Text
  sourceConversationId String?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  project            Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  sourceConversation Conversation? @relation(fields: [sourceConversationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([projectId])
}

model ToolExecution {
  id             String              @id @default(cuid())
  conversationId String?
  messageId      String?
  toolName       String
  input          Json
  output         Json?
  status         ToolExecutionStatus @default(PENDING)
  durationMs     Int?
  createdAt      DateTime            @default(now())

  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  message      Message?      @relation(fields: [messageId], references: [id], onDelete: SetNull)
}

model UsageRecord {
  id             String   @id @default(cuid())
  userId         String
  model          String
  inputTokens    Int
  outputTokens   Int
  requestType    String
  conversationId String?
  createdAt      DateTime @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

model Feedback {
  id        String   @id @default(cuid())
  userId    String
  messageId String
  rating    MessageFeedback
  comment   String?
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  name       String
  keyHash    String
  prefix     String
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([prefix])
}

model Subscription {
  id               String             @id @default(cuid())
  userId           String             @unique
  plan             Plan               @default(FREE)
  status           SubscriptionStatus @default(ACTIVE)
  currentPeriodEnd DateTime?
  metadata         Json?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model FeatureFlag {
  id          String   @id @default(cuid())
  key         String   @unique
  enabled     Boolean  @default(false)
  description String?
  updatedAt   DateTime @updatedAt
}

enum TaskStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TaskType {
  RESEARCH
  ANALYSIS
  DOCUMENT
  CODING
  PROJECT
  GENERAL
}

model Task {
  id            String        @id @default(cuid())
  userId        String
  projectId     String?
  title         String
  description   String?       @db.Text
  type          TaskType      @default(GENERAL)
  status        TaskStatus    @default(PENDING)
  priority      TaskPriority  @default(NORMAL)
  resultSummary String?       @db.Text
  metadata      Json?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  completedAt   DateTime?

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  project       Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  executions    TaskExecution[]
  steps         TaskStep[]
  activityLogs  ActivityLog[]

  @@index([userId, status])
  @@index([userId, projectId])
  @@index([userId, updatedAt])
}

model TaskExecution {
  id          String        @id @default(cuid())
  taskId      String
  status      TaskStatus    @default(RUNNING)
  startedAt   DateTime      @default(now())
  completedAt DateTime?
  durationMs  Int?
  error       String?       @db.Text
  summary     String?       @db.Text
  metadata    Json?

  task        Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([status])
}

model TaskStep {
  id          String        @id @default(cuid())
  taskId      String
  stepNumber  Int
  title       String
  description String?       @db.Text
  status      TaskStatus    @default(PENDING)
  toolName    String?
  toolInput   Json?
  toolResult  Json?
  error       String?       @db.Text
  startedAt   DateTime?
  completedAt DateTime?

  task        Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, stepNumber])
}

model ActivityLog {
  id          String    @id @default(cuid())
  userId      String
  projectId   String?
  taskId      String?
  eventType   String
  description String
  metadata    Json?
  createdAt   DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  task        Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([projectId])
  @@index([taskId])
}
