# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env*.local
!.env.example

# local uploads
/uploads
uploads/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local uploads
/uploads
/uploads/**

# python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# trained weights and prepared data — large and regenerable from scripts/.
# tokenizers/ is deliberately tracked: every checkpoint pins its checksum,
# so inference cannot run against a differently-trained vocabulary.
/checkpoints/
/datasets/
/data/raw/
/data/processed/
/data/packed_pretrain/
*.pt
*.safetensors
*.bin

# generated evaluation output
/reports/

